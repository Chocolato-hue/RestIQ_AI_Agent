# RestIQ environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env — it is gitignored.

# ── Required for check-ins (Gemini parses natural-language sleep logs) ────────
# Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Optional: Gemini model for intake + ADK agent ───────────────────────────
# Default if unset: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ── Required for Telegram bot (uv run python bot.py) ──────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── Required for Streamlit "Connect Telegram" deep links ──────────────────────
# Bot username without @, e.g. if your bot is @MyRestIQBot use MyRestIQBot
TELEGRAM_BOT_USERNAME=Rest_IQ_Bot

OPEN_WEARABLES_BASE_URL=http://localhost:8000
OPEN_WEARABLES_API_KEY=apikey
OPEN_WEARABLES_DEMO_USER_ID=userdemo
